# Copy to .env for local development. Never commit .env.
APP_ENV=development
DEBUG=true
DOCS_ENABLED=true

DATABASE_URL=postgresql+asyncpg://msrf:msrf@localhost:5432/msrf
DATABASE_URL_SYNC=postgresql+psycopg://msrf:msrf@localhost:5432/msrf

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
# true = run Celery tasks inline (no worker needed in local dev)
CELERY_TASK_ALWAYS_EAGER=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_ABSOLUTE_EXPIRE_DAYS=30

# Comma-separated. Admin SPA (Vite) and website (Next.js) dev servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
# Base URL for links in emails (set-password page)
ADMIN_APP_URL=http://localhost:5173

# smtp | console | memory
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=MSRF Academy

# Public base URL of this API (used to build signed links to private files)
API_BASE_URL=http://localhost:8000
# local (files under MEDIA_ROOT, dev) | s3 (S3 / Cloudflare R2 / MinIO)
STORAGE_BACKEND=local
MEDIA_ROOT=media
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media/public
FILE_URL_TTL_SECONDS=3600
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=msrf-private
S3_BUCKET_PUBLIC=msrf-public

# Cloudflare Turnstile secret for public website forms (empty = disabled)
TURNSTILE_SECRET_KEY=
